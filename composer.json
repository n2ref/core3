{
  "name": "n2ref/rowan",
  "version": "3.0.0",
  "type": "framework",
  "description": "CRM for business application",
  "keywords": ["framework"],
  "homepage": "https://github.com/n2ref/rowan",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "n2ref",
      "role": "Developer"
    }
  ],
  "minimum-stability": "dev",
  "classmap-authoritative": true,
  "prefer-stable": true,
  "scripts": {
    "post-update-cmd": [
      "@php ../public/index.php --ipdb"
    ],
    "test:api": "phpunit --testsuite tests/api"
  },
  "require": {
    "php": ">=8.5",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-zip": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "ext-gd": "*",
    "ext-imagick": "*",
    "ext-imap": "*",
    "ext-intl": "*",
    "ext-xml": "*",
    "ext-sockets": "*",

    "laravel/reverb": "v1.12.0",
    "laravel/pulse": "v1.8.1",

    "illuminate/cache": "v13.40.0",
    "illuminate/mail": "v13.40.0",
    "illuminate/log": "v13.40.0",
    "illuminate/database": "v13.40.0",
    "illuminate/queue": "v13.40.0",
    "illuminate/auth": "v13.40.0",
    "illuminate/filesystem": "v13.40.0",
    "illuminate/validation": "v13.40.0",
    "illuminate/support": "v13.40.0",
    "illuminate/translation": "v13.40.0",

    "n2ref/coreui-panel": "1.0.x-dev",
    "n2ref/coreui-table": "dev-main",
    "n2ref/coreui-form": "1.0.8",
    "n2ref/coreui-form-field-select2": "dev-main",
    "n2ref/coreui-info": "v1.0.0",
    "n2ref/coreui-layout": "1.0.x-dev",
    "n2ref/coreui-breadcrumb": "v1.0.1",

    "geoip2/geoip2": "v3.3.0",
    "gumlet/php-image-resize": "2.1.3",
    "jdenticon/jdenticon": "2.0.0",
    "monolog/monolog": "3.10.0",
    "guzzlehttp/guzzle": "7.16.1",
    "firebase/php-jwt": "v7.0.5",
    "wolfcast/browser-detection": "2.9.9",

    "ratchet/rfc6455": "v0.4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "13.1.13"
  }
}
